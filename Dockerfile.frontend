# VitaGrid GOV - Frontend Production Container
# Multi-stage build with Node.js and Alpine Nginx

FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first for optimal caching
COPY package.json bun.lock* package-lock.json* ./
RUN npm install --frozen-lockfile || npm install

# Copy source code and build Vite production bundle
COPY . .
RUN npm run build

# Stage 2: Minimal Nginx web server
FROM nginx:alpine

# Remove default nginx site
RUN rm -rf /etc/nginx/conf.d/*

# Copy custom reverse-proxy configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy Vite build output to nginx document root
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
